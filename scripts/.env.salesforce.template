# ═══════════════════════════════════════════════════════════════════════════
#  ArchonAI — Salesforce Validation Environment Template
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copy to .env.salesforce and fill in values.
#  NEVER commit the filled-in file.
#
#  Usage:
#    cp scripts/.env.salesforce.template .env.salesforce
#    # Fill in values
#    set -a && source .env.salesforce && set +a
#    bash scripts/validate-salesforce.sh
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required ─────────────────────────────────────────────────────────────

# OAuth 2.0 Connected App credentials
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Your Salesforce instance URL (e.g., https://mycompany.my.salesforce.com)
# For sandboxes, use the sandbox instance URL
SALESFORCE_INSTANCE_URL=

# ─── Optional: Password Grant (matches SalesforceConnector auth flow) ────

# If set, the script uses password grant (matching the connector).
# If omitted, the script uses client_credentials flow.
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=

# ─── Optional: Overrides ─────────────────────────────────────────────────

# Login URL — use https://test.salesforce.com for sandbox orgs
SALESFORCE_LOGIN_URL=https://test.salesforce.com

# API version — must match the version in SalesforceOptions.cs
SALESFORCE_API_VERSION=v59.0

# Report output directory
# SALESFORCE_REPORT_DIR=./live-validation-results
