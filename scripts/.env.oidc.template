# ═══════════════════════════════════════════════════════════════════════════
#  ArchonAI — OIDC Validation Environment Template
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copy to .env.oidc and fill in values.
#  NEVER commit the filled-in file.
#
#  Usage:
#    cp scripts/.env.oidc.template .env.oidc
#    # Fill in values
#    set -a && source .env.oidc && set +a
#    bash scripts/validate-oidc.sh
# ═══════════════════════════════════════════════════════════════════════════

# ─── Required ─────────────────────────────────────────────────────────────

# OIDC Issuer URL — must expose .well-known/openid-configuration
#
# Examples:
#   Okta:      https://dev-123456.okta.com/oauth2/default
#   Entra ID:  https://login.microsoftonline.com/{tenant-id}/v2.0
#   Auth0:     https://your-tenant.auth0.com
#   Keycloak:  https://keycloak.example.com/realms/myrealm
OIDC_ISSUER=

# OAuth 2.0 client credentials
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ─── Optional ─────────────────────────────────────────────────────────────

# Scope for client_credentials token exchange (default: openid)
# OIDC_SCOPE=openid

# Report output directory
# OIDC_REPORT_DIR=./live-validation-results
