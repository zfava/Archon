{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Information",
        "System": "Warning"
      }
    }
  },
  "Security": {
    "Jwt": {
      "Issuer": "ArchonAI",
      "Audience": "ArchonAI.Api",
      "ClockSkewSeconds": 60
    }
  },
  "ReverseProxy": {
    "Routes": {
      "api-health": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "health",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/{version}/health"
        },
        "Transforms": [
          { "RequestHeader": "X-Forwarded-Service", "Set": "gateway" }
        ]
      },
      "api-registry": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/registry/{**catch-all}"
        }
      },
      "api-traces": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/traces/{**catch-all}"
        }
      },
      "api-patterns": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/patterns/{**catch-all}"
        }
      },
      "api-strategies": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/strategies/{**catch-all}"
        }
      },
      "api-connectors": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "connectors",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/connectors/{**catch-all}"
        }
      },
      "api-operations": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/operations/{**catch-all}"
        }
      },
      "api-finance": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/finance/{**catch-all}"
        }
      },
      "api-sales": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/sales/{**catch-all}"
        }
      },
      "api-marketing": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/marketing/{**catch-all}"
        }
      },
      "api-support": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/support/{**catch-all}"
        }
      },
      "api-admin": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "admin",
        "AuthorizationPolicy": "AdminOnly",
        "Match": {
          "Path": "/api/{version}/admin/{**catch-all}"
        }
      },
      "api-observability": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/observability/{**catch-all}"
        }
      },
      "api-workflows": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/workflows/{**catch-all}"
        }
      },
      "api-monitoring": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/monitoring/{**catch-all}"
        }
      },
      "api-audit": {
        "ClusterId": "api-cluster",
        "RateLimiterPolicy": "standard",
        "AuthorizationPolicy": "OperatorOrAdmin",
        "Match": {
          "Path": "/api/{version}/audit/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "api-cluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:30",
            "Timeout": "00:00:10",
            "Path": "/api/v1/health"
          }
        },
        "HttpClient": {
          "RequestHeaderEncoding": "utf-8"
        },
        "Destinations": {
          "api-1": {
            "Address": "http://archonai-api:80"
          }
        }
      }
    }
  }
}
