{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Operations": {
    "MaxReasoningCycles": 5,
    "MaxInsightsPerAnalysis": 20,
    "MaxRecommendationsPerObjective": 10,
    "InefficiencyThreshold": 0.6,
    "MaxConcurrentCoordinations": 10,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "RequiredRoles": [ "Operator", "Admin" ]
  },
  "Finance": {
    "AnomalySensitivityDefault": 0.7,
    "MaxAnomaliesPerScan": 50,
    "HighSeverityThreshold": 0.8,
    "DeviationAlertThreshold": 0.15,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "RequiredRoles": [ "Operator", "Admin" ],
    "FinancialSources": [ "quickbooks", "financial" ]
  },
  "Sales": {
    "MaxOpportunitiesPerPrioritization": 50,
    "MaxOutreachRecommendations": 10,
    "MinPriorityScore": 0.3,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "CrmSources": [ "salesforce", "hubspot", "crm" ],
    "RequiredRoles": [ "Operator", "Admin" ]
  },
  "Marketing": {
    "MaxStrategiesPerRecommendation": 10,
    "MinROIThreshold": 1.0,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "MarketingSources": [ "hubspot", "crm" ],
    "RequiredRoles": [ "Operator", "Admin" ]
  },
  "Support": {
    "MinRecurrenceThreshold": 3,
    "MaxAutoResponses": 10,
    "MinAutoResponseConfidence": 0.7,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "SupportSources": [ "crm", "messaging" ],
    "RequiredRoles": [ "Operator", "Admin" ]
  },
  "Policy": {
    "DefaultConfidenceScore": 0.5,
    "ManualOverrideSigningKey": ""
  },
  "EventBus": {
    "UseNats": true,
    "Url": "nats://localhost:4222"
  },
  "MemoryPersistence": {
    "Schema": "public"
  }
}
