{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Security": {
    "Jwt": {
      "Issuer": "ArchonAI",
      "Audience": "ArchonAI.Api",
      "ClockSkewSeconds": 60
    }
  },
  "Authentication": {
    "AccessTokenLifetimeMinutes": 30,
    "RefreshTokenLifetimeDays": 7,
    "InviteTokenLifetimeDays": 7
  },
  "Runtime": {
    "MaxDegreeOfParallelism": 128,
    "MaxRetries": 2,
    "BaseRetryDelayMs": 250,
    "QueueShardCount": 64
  },
  "Plugins": {
    "AutoDiscoverInDirectories": true,
    "PluginDirectories": [
      "./plugins"
    ],
    "AgentAssemblies": [],
    "ToolAssemblies": [],
    "ConnectorAssemblies": [],
    "EvaluationAssemblies": []
  },
  "ModelProviders": {
    "DefaultModel": "openai.gpt-4.1-mini",
    "OpenAI": {
      "Enabled": true,
      "Endpoint": "https://api.openai.com"
    },
    "AzureOpenAI": {
      "Enabled": false,
      "Deployment": "gpt-4o-mini"
    },
    "Anthropic": {
      "Enabled": true,
      "Endpoint": "https://api.anthropic.com"
    },
    "Local": {
      "Enabled": true,
      "Endpoint": "http://localhost:11434",
      "DefaultModel": "local.default"
    }
  },
  "KnowledgeGraph": {
    "Schema": "public"
  },
  "Policy": {
    "MaxTaskInputCount": 50,
    "ForbiddenCapabilities": [],
    "HighRiskCapabilities": [
      "financial-operations",
      "external.connector",
      "workflow-orchestration"
    ],
    "ApprovalCheckpointCapabilities": [
      "financial-operations",
      "workflow-orchestration"
    ],
    "DefaultApprovalCheckpoint": "operator-review",
    "RequireApprovalCheckpointForHighRisk": true,
    "DefaultConfidenceScore": 0.5,
    "MinConfidenceThreshold": 0.65,
    "ConfidenceRiskWeight": 50,
    "AutoBlockRiskThreshold": 80,
    "ApprovalRiskThreshold": 60,
    "ManualOverrideSigningKey": ""
  },
  "Simulation": {
    "BaseSuccessProbability": 0.78,
    "RiskPenaltyWeight": 0.12,
    "LatencyWeightMs": 120,
    "CostPerStep": 0.006
  },
  "Scheduler": {
    "MaxGpuSlots": 4,
    "MaxParallelTasks": 128,
    "DefaultTaskPriority": 100,
    "DefaultModel": "general-purpose",
    "CapabilityModelRoutes": {
      "financial-operations": "finance-optimized",
      "workflow-orchestration": "planner-optimized",
      "knowledge.query": "retrieval-optimized"
    }
  },
  "Trace": {
    "MaxEntries": 5000
  },
  "TelemetryPersistence": {
    "Schema": "archonai"
  },
  "Patterns": {
    "MinRecurringFailureCount": 3,
    "MinHighPerformanceSuccesses": 3,
    "HighPerformanceMaxExecutionMs": 1500
  },
  "Strategy": {
    "Seeds": [
      {
        "ObjectiveType": "default",
        "WorkflowTemplate": "balanced",
        "RecommendedAgents": [
          "workflow-orchestration",
          "tooling-execution"
        ],
        "SuccessMetrics": {
          "successRate": "0.80",
          "avgExecutionMs": "1200"
        }
      },
      {
        "ObjectiveType": "financial",
        "WorkflowTemplate": "safe-mode",
        "RecommendedAgents": [
          "financial-operations",
          "workflow-orchestration"
        ],
        "SuccessMetrics": {
          "successRate": "0.92",
          "avgExecutionMs": "1500"
        }
      }
    ]
  },
  "Governance": {
    "AllowAgentRegistration": true,
    "EnforcePermissionCheck": true,
    "RequiredExecutionPermission": "execute:tasks",
    "MaxConcurrentExecutionsPerAgent": 20,
    "MaxExecutionsPerHourPerAgent": 500,
    "AllowedCapabilities": []
  },
  "Supervisor": {
    "MaxExecutionsInWindow": 50,
    "RunawayWindowSeconds": 60,
    "ConsecutiveFailuresBeforeRestart": 3,
    "MaxRestartsPerHour": 5,
    "UnsafeErrorKeyword": "unsafe"
  },
  "Sandbox": {
    "DefaultMemoryLimitMb": 1024,
    "DefaultCpuQuotaPercent": 70,
    "DefaultNetworkAccessAllowed": false,
    "AllowedApiPermissions": [
      "execute:tasks",
      "read:memory"
    ]
  },
  "Orchestrator": {
    "MaxDegreeOfParallelism": 16,
    "MaxRetries": 2,
    "BaseRetryDelayMs": 150,
    "MaxDispatchesPerSecond": 100
  },
  "WorkflowRuntime": {
    "DefaultMaxParallelism": 16
  },
  "TaskRuntime": {
    "MaxRetries": 2,
    "BaseRetryDelayMs": 250
  },
  "Identity": {
    "MaxExecutionHistoryEntries": 200
  },
  "Oidc": {
    "CallbackBaseUrl": "https://localhost:5001",
    "CallbackPath": "/api/v1/auth/oidc/callback",
    "StateExpirationSeconds": 300,
    "PostLoginRedirectUrl": "/"
  },
  "Context": {
    "Scope": "system:context",
    "OrganizationalGoals": [
      "maximize-enterprise-value",
      "maintain-operational-resilience"
    ],
    "OperationalPriorities": [
      "balanced",
      "safe-mode"
    ],
    "EnvironmentConstraints": {
      "region": "global",
      "compliance": "strict"
    },
    "HistoricalKnowledge": [
      "safe-mode-reduces-failure-rates",
      "throughput-optimized-can-increase-cost"
    ]
  },
  "Perception": {
    "MaxTitleLength": 200,
    "MaxDescriptionLength": 4000,
    "RequiredConstraintKeys": [
      "objectiveType"
    ],
    "NoiseTokens": [
      "um",
      "uh",
      "like",
      "you know",
      "basically"
    ]
  },
  "PatternDiscovery": {
    "MinRecurringFailures": 3,
    "HighExecutionLatencyThresholdMs": 1800,
    "MinExecutionsForRanking": 3,
    "StrategyCandidateMinSuccesses": 3,
    "IntelligenceScopePrefix": "intelligence:pattern-discovery"
  },
  "Connectors": {
    "Salesforce": {
      "LoginUrl": "https://login.salesforce.com",
      "ApiVersion": "v59.0",
      "MaxRetries": 3,
      "RetryBaseDelayMs": 1000,
      "RateLimitBufferPercent": 10,
      "HttpTimeoutSeconds": 30,
      "RequiredRoles": [ "Operator", "Admin" ]
    },
    "HubSpot": {
      "BaseUrl": "https://api.hubapi.com",
      "OAuthTokenUrl": "https://api.hubapi.com/oauth/v1/token",
      "MaxRetries": 3,
      "RetryBaseDelayMs": 1000,
      "RateLimitBufferPercent": 10,
      "HttpTimeoutSeconds": 30,
      "RequiredRoles": [ "Operator", "Admin" ]
    },
    "QuickBooks": {
      "BaseUrl": "https://quickbooks.api.intuit.com",
      "OAuthTokenUrl": "https://oauth.platform.intuit.com/oauth2/v1/tokens/bearer",
      "ApiVersion": "v3",
      "MaxRetries": 3,
      "RetryBaseDelayMs": 1000,
      "HttpTimeoutSeconds": 30,
      "RequiredRoles": [ "Operator", "Admin" ]
    },
    "Slack": {
      "BaseUrl": "https://slack.com/api",
      "MaxRetries": 3,
      "RetryBaseDelayMs": 1000,
      "HttpTimeoutSeconds": 30,
      "RequiredRoles": [ "Operator", "Admin" ],
      "DefaultAlertChannel": ""
    },
    "GoogleWorkspace": {
      "OAuthTokenUrl": "https://oauth2.googleapis.com/token",
      "GmailBaseUrl": "https://gmail.googleapis.com/gmail/v1",
      "DocsBaseUrl": "https://docs.googleapis.com/v1",
      "SheetsBaseUrl": "https://sheets.googleapis.com/v4",
      "DriveBaseUrl": "https://www.googleapis.com/drive/v3",
      "MaxRetries": 3,
      "RetryBaseDelayMs": 1000,
      "HttpTimeoutSeconds": 30,
      "RequiredRoles": [ "Operator", "Admin" ]
    },
    "Microsoft365": {
      "GraphBaseUrl": "https://graph.microsoft.com/v1.0",
      "OAuthTokenUrl": "https://login.microsoftonline.com/{TenantId}/oauth2/v2.0/token",
      "Scope": "https://graph.microsoft.com/.default",
      "MaxRetries": 3,
      "RetryBaseDelayMs": 1000,
      "HttpTimeoutSeconds": 30,
      "RequiredRoles": [ "Operator", "Admin" ]
    }
  },
  "Finance": {
    "AnomalySensitivityDefault": 0.7,
    "MaxAnomaliesPerScan": 50,
    "HighSeverityThreshold": 0.8,
    "DeviationAlertThreshold": 0.15,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "RequiredRoles": [ "Operator", "Admin" ],
    "FinancialSources": [ "quickbooks", "financial" ]
  },
  "Operations": {
    "MaxReasoningCycles": 5,
    "MaxInsightsPerAnalysis": 20,
    "MaxRecommendationsPerObjective": 10,
    "InefficiencyThreshold": 0.6,
    "MaxConcurrentCoordinations": 10,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "RequiredRoles": [ "Operator", "Admin" ]
  },
  "Sales": {
    "MaxOpportunitiesPerPrioritization": 50,
    "MaxOutreachRecommendations": 10,
    "MinPriorityScore": 0.3,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "CrmSources": [ "salesforce", "hubspot", "crm" ],
    "RequiredRoles": [ "Operator", "Admin" ]
  },
  "Marketing": {
    "MaxStrategiesPerRecommendation": 10,
    "MinROIThreshold": 1.0,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "MarketingSources": [ "hubspot", "crm" ],
    "RequiredRoles": [ "Operator", "Admin" ]
  },
  "Support": {
    "MinRecurrenceThreshold": 3,
    "MaxAutoResponses": 10,
    "MinAutoResponseConfidence": 0.7,
    "DataFabricPermissions": [ "read:datafabric:agent" ],
    "DefaultConsumerType": "agent",
    "SupportSources": [ "crm", "messaging" ],
    "RequiredRoles": [ "Operator", "Admin" ]
  },
  "Rbac": {
    "DefaultDenyUnmatched": true,
    "AuditAllAccessChecks": true,
    "CachePermissionsDurationSeconds": 300
  },
  "Admin": {
    "RequiredRoles": [ "Admin" ],
    "MaxWorkflowHistoryEntries": 200,
    "MonitoringSnapshotIntervalSeconds": 60
  },
  "DataFabric": {
    "AllowedSources": [
      "crm",
      "erp",
      "messaging",
      "financial",
      "salesforce",
      "hubspot",
      "quickbooks",
      "slack",
      "google-workspace",
      "microsoft365"
    ],
    "PlannerPermissions": [
      "read:datafabric:planner"
    ],
    "AgentPermissions": [
      "read:datafabric:agent"
    ],
    "MaxRows": 200
  },
  "MultiTenant": {
    "DefaultTenantId": "default-org",
    "MaxConcurrentPlansPerTenant": 10,
    "MaxTasksPerPlanPerTenant": 500,
    "MaxMemoryRecordsPerScopePerTenant": 5000
  },
  "Learning": {
    "GlobalTenantId": "global-intelligence",
    "MinTenantCoverageForGlobalPattern": 2,
    "MaxInsights": 50
  },
  "Optimization": {
    "InefficientStepThreshold": 6,
    "MaxImprovedStrategies": 3,
    "AutoDeployOptimizedWorkflows": true
  },
  "ControlPlane": {
    "MaxTenants": 100,
    "DefaultPolicyPriority": 100,
    "EnforceQuotas": true,
    "RequiredRoles": [ "Admin" ]
  },
  "AuditLog": {
    "MaxEntries": 50000,
    "RetentionDays": 90,
    "EnableIntegrityVerification": true,
    "IntegrityCheckIntervalMinutes": 60
  },
  "Observability": {
    "MaxTraceEntries": 10000,
    "MetricsSnapshotIntervalSeconds": 30,
    "EnableDetailedTracing": true,
    "AlertThresholds": {
      "ErrorRatePercent": 10,
      "LatencyMs": 5000,
      "MemoryUsagePercent": 85
    }
  },
  "Demo": {
    "Enabled": true,
    "MaxConcurrentDemos": 3,
    "DefaultTrustTierThreshold": 500000,
    "DefaultScenario": "finance-approval"
  },
  "ModelRouter": {
    "DefaultProvider": "openai",
    "DefaultModel": "openai.gpt-4.1-mini",
    "CostOptimizedProvider": "openai",
    "CostOptimizedModel": "openai.gpt-4.1-nano",
    "LatencyOptimizedProvider": "azure-openai",
    "LatencyOptimizedModel": "azure.gpt-4o-mini",
    "QualityOptimizedProvider": "openai",
    "QualityOptimizedModel": "openai.gpt-4.1",
    "TaskTypeModelMap": {
      "analysis": "openai.gpt-4.1",
      "classification": "azure.gpt-4o-mini",
      "extraction": "anthropic.claude-sonnet-4-6",
      "drafting": "openai.gpt-4.1",
      "lightweight": "openai.gpt-4.1-nano"
    }
  }
}
