{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Security": {
    "Jwt": {
      "Issuer": "ArchonAI",
      "Audience": "ArchonAI.Api",
      "ClockSkewSeconds": 60
    }
  },
  "Runtime": {
    "MaxDegreeOfParallelism": 128,
    "MaxRetries": 2,
    "BaseRetryDelayMs": 250,
    "QueueShardCount": 64
  },
  "Plugins": {
    "AutoDiscoverInDirectories": true,
    "PluginDirectories": [
      "./plugins"
    ],
    "AgentAssemblies": [],
    "ToolAssemblies": [],
    "ConnectorAssemblies": [],
    "EvaluationAssemblies": []
  },
  "ModelProviders": {
    "DefaultModel": "local.default",
    "OpenAI": {
      "ApiKey": "",
      "Endpoint": "https://api.openai.com"
    },
    "AzureOpenAI": {
      "ApiKey": "",
      "Endpoint": "",
      "Deployment": "gpt-4o-mini"
    },
    "Anthropic": {
      "ApiKey": "",
      "Endpoint": "https://api.anthropic.com"
    },
    "Local": {
      "Endpoint": "http://localhost:11434",
      "DefaultModel": "local.default"
    }
  },
  "KnowledgeGraph": {
    "ConnectionString": "",
    "Schema": "public"
  },
  "Policy": {
    "MaxTaskInputCount": 50,
    "ForbiddenCapabilities": [],
    "HighRiskCapabilities": [
      "financial-operations",
      "external.connector",
      "workflow-orchestration"
    ],
    "ApprovalCheckpointCapabilities": [
      "financial-operations",
      "workflow-orchestration"
    ],
    "DefaultApprovalCheckpoint": "operator-review",
    "RequireApprovalCheckpointForHighRisk": true,
    "MinConfidenceThreshold": 0.65,
    "ConfidenceRiskWeight": 50,
    "AutoBlockRiskThreshold": 80,
    "ApprovalRiskThreshold": 60
  },
  "Simulation": {
    "BaseSuccessProbability": 0.78,
    "RiskPenaltyWeight": 0.12,
    "LatencyWeightMs": 120,
    "CostPerStep": 0.006
  },
  "Scheduler": {
    "MaxGpuSlots": 4,
    "MaxParallelTasks": 128,
    "DefaultTaskPriority": 100,
    "DefaultModel": "general-purpose",
    "CapabilityModelRoutes": {
      "financial-operations": "finance-optimized",
      "workflow-orchestration": "planner-optimized",
      "knowledge.query": "retrieval-optimized"
    }
  },
  "Trace": {
    "MaxEntries": 5000
  },
  "TelemetryPersistence": {
    "ConnectionString": "",
    "Schema": "archonai"
  },
  "Patterns": {
    "MinRecurringFailureCount": 3,
    "MinHighPerformanceSuccesses": 3,
    "HighPerformanceMaxExecutionMs": 1500
  },
  "Strategy": {
    "Seeds": [
      {
        "ObjectiveType": "default",
        "WorkflowTemplate": "balanced",
        "RecommendedAgents": [
          "workflow-orchestration",
          "tooling-execution"
        ],
        "SuccessMetrics": {
          "successRate": "0.80",
          "avgExecutionMs": "1200"
        }
      },
      {
        "ObjectiveType": "financial",
        "WorkflowTemplate": "safe-mode",
        "RecommendedAgents": [
          "financial-operations",
          "workflow-orchestration"
        ],
        "SuccessMetrics": {
          "successRate": "0.92",
          "avgExecutionMs": "1500"
        }
      }
    ]
  },
  "Governance": {
    "AllowAgentRegistration": true,
    "EnforcePermissionCheck": true,
    "RequiredExecutionPermission": "execute:tasks",
    "MaxConcurrentExecutionsPerAgent": 20,
    "MaxExecutionsPerHourPerAgent": 500,
    "AllowedCapabilities": []
  }
}
