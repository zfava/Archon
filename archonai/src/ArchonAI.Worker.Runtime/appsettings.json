{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Runtime": {
    "MaxDegreeOfParallelism": 128,
    "MaxRetries": 2,
    "BaseRetryDelayMs": 250,
    "QueueShardCount": 64
  },
  "EventBus": {
    "UseNats": true,
    "Url": "nats://localhost:4222"
  },
  "MemoryPersistence": {
    "Schema": "public"
  }
}
