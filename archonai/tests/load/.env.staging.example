# ══════════════════════════════════════════════════════════════════
#  ArchonAI Staging Baseline — Environment Configuration
# ══════════════════════════════════════════════════════════════════
#
#  Copy this file and fill in ALL values before running:
#    cp .env.staging.example .env.staging
#    source .env.staging
#
#  Then execute:
#    ./run-baseline.sh
#
#  IMPORTANT: NEVER commit .env.staging with real credentials.
# ══════════════════════════════════════════════════════════════════

# ─── Target Environment ─────────────────────────────────────────
# Gateway URL — the YARP reverse proxy endpoint for staging.
BASE_URL=http://STAGING_HOST:8080

# Human-readable environment name for audit trail.
# Values: staging | staging-2 | pre-prod
ENVIRONMENT_NAME=staging

# ─── Deployment Identity ────────────────────────────────────────
# Container image tag(s) under test. Obtain from deployment manifest or CI.
# Example: ghcr.io/archonai/api:1.2.3-rc1
DEPLOY_IMAGE_TAG=

# Last applied database migration identifier.
# Find via: SELECT * FROM __EFMigrationsHistory ORDER BY MigrationId DESC LIMIT 1;
MIGRATION_VERSION=

# ─── AI & Connector Configuration ──────────────────────────────
# Which AI provider routing is active during this run.
# Values: cloud-openai | cloud-anthropic | azure-openai | local-ollama | mixed
AI_PROVIDER_MODE=cloud-openai

# How connectors are configured for this run.
# Values: live-sandbox | mock-stub | hybrid
# If hybrid, document per-provider configuration in the results template.
CONNECTOR_CONFIG_MODE=live-sandbox

# ─── Output ─────────────────────────────────────────────────────
# Results directory. Leave empty to use auto-timestamped default.
# REPORT_DIR=./results/baseline-$(date +%Y%m%d-%H%M%S)

# ─── Test User Credentials ──────────────────────────────────────
# These users must be pre-seeded in the staging database.
ADMIN_EMAIL=loadtest-admin@archonai.test
ADMIN_PASSWORD=LoadTest!Admin#2026

OPERATOR_EMAIL=loadtest-operator@archonai.test
OPERATOR_PASSWORD=LoadTest!Operator#2026

VIEWER_EMAIL=loadtest-viewer@archonai.test
VIEWER_PASSWORD=LoadTest!Viewer#2026

# ─── Multi-Tenant Isolation ────────────────────────────────────
# Number of tenants to test. Must match seeded tenant count.
# Tenant users: loadtest-tenant0@archonai.test through loadtest-tenant9@archonai.test
TENANT_COUNT=10
