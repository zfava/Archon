FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ./archonai/ArchonAI.slnx ./
COPY ./archonai/src ./src

RUN dotnet restore ./src/ArchonAI.Gateway/ArchonAI.Gateway.csproj
RUN dotnet publish ./src/ArchonAI.Gateway/ArchonAI.Gateway.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime

RUN getent group archon >/dev/null 2>&1 || groupadd archon && \
    getent passwd archon >/dev/null 2>&1 || useradd --gid archon --shell /bin/false --create-home archon

WORKDIR /app

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

COPY --from=build --chown=archon:archon /app/publish .
USER archon
ENTRYPOINT ["dotnet", "ArchonAI.Gateway.dll"]
