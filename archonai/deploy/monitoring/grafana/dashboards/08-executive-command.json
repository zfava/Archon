      "collapsed": false,
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Loop Cycle Rate & Failures",
      "description": "Completed and failed loop cycle rates, stacked to show total throughput and failure proportion.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "rate(archonai_loop_cycles_completed_total[5m])",
          "legendFormat": "Completed/s",
          "refId": "A"
        },
        {
          "expr": "rate(archonai_loop_cycles_failures_total[5m])",
          "legendFormat": "Failures/s",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" }
          },
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failures/s" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "type": "timeseries",
      "title": "Loop Cycle Duration P95",
      "description": "95th percentile of loop cycle duration in milliseconds, showing worst-case decision pipeline latency.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(archonai_loop_cycle_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "P95 Duration (ms)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "pointSize": 5,
