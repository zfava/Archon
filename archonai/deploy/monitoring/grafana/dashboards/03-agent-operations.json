      "title": "Total Registered Agents",
      "description": "Total number of agents registered in the agent registry since inception.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
