{
  "uid": "archonai-connector-health",
  "title": "ArchonAI — Connector Health",
  "tags": ["archonai", "connectors"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Connector Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Total Auth Attempts/hr",
      "description": "Sum of authentication attempts across all connectors in the last hour.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(archonai_salesforce_auth_attempts_total[1h])) + sum(increase(archonai_hubspot_auth_attempts_total[1h])) + sum(increase(archonai_quickbooks_auth_attempts_total[1h])) + sum(increase(archonai_slack_auth_attempts_total[1h])) + sum(increase(archonai_google_workspace_auth_attempts_total[1h])) + sum(increase(archonai_m365_auth_attempts_total[1h]))",
          "legendFormat": "Auth Attempts",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Total Errors/hr",
