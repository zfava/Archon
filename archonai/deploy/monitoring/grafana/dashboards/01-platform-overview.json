    {
      "id": 13,
      "type": "timeseries",
      "title": "Memory Usage",
      "description": "Resident memory (RSS) consumed by each ArchonAI service process. Sustained growth may indicate a memory leak; sudden spikes may correlate with load surges.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
