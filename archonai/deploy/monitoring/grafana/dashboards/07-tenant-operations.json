      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Control Plane Operations",
      "description": "Stacked rate of all control plane operation types over time.",
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(archonai_controlplane_tenant_ops_total[5m]))",
          "legendFormat": "Tenant Ops"
        },
        {
          "refId": "B",
          "expr": "sum(rate(archonai_controlplane_workflow_ops_total[5m]))",
          "legendFormat": "Workflow Ops"
        },
        {
          "refId": "C",
          "expr": "sum(rate(archonai_controlplane_agent_ops_total[5m]))",
          "legendFormat": "Agent Ops"
        },
        {
          "refId": "D",
          "expr": "sum(rate(archonai_controlplane_config_ops_total[5m]))",
          "legendFormat": "Config Ops"
        },
        {
          "refId": "E",
          "expr": "sum(rate(archonai_controlplane_policy_ops_total[5m]))",
          "legendFormat": "Policy Ops"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "gradientMode": "none",
            "showPoints": "never",
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" },
            "spanNulls": false
          },
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] }
      }
    },
    {
      "type": "timeseries",
      "title": "Tenant Operations Over Time",
      "description": "Rate of tenant-specific operations broken down by tenant ID.",
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(archonai_controlplane_tenant_ops_total[5m])",
          "legendFormat": "{{tenant_id}}"
