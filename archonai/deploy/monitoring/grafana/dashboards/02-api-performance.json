      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 11,
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum(rate(archonai_gateway_requests_total[5m])) by (route))",
