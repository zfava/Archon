{
  "uid": "archonai-operations",
  "title": "ArchonAI — Operations",
  "tags": ["archonai", "operations", "sre"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "System Health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": []
    },
    {
      "type": "gauge",
      "title": "API Request Rate (req/s)",
      "description": "Total API request rate averaged over a 5-minute window.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(archonai_gateway_requests_total[5m]))",
          "legendFormat": "req/s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "max": 500,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 400 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "type": "stat",
      "title": "API P95 Latency (ms)",
      "description": "95th percentile request latency in milliseconds over the last 5 minutes.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 3,
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(archonai_gateway_request_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "P95",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 500 },
              { "color": "red", "value": 2000 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "API Error Rate (%)",
      "description": "Percentage of failed requests over total requests in the last 5 minutes.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 4,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(archonai_gateway_requests_failed_total[5m])) / sum(rate(archonai_gateway_requests_total[5m])) * 100",
          "legendFormat": "Error %",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Active Workflows",
      "description": "Number of workflows currently in execution (queued minus completed/failed).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 5,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(archonai_workflow_designs_executed_total) - sum(archonai_workflow_designs_validated_total) + sum(archonai_workflow_designs_created_total)",
          "legendFormat": "Active",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "row",
      "title": "Agent Execution",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 10,
      "panels": []
    },
    {
      "type": "barchart",
      "title": "Task Success Rate per Agent Type",
      "description": "Ratio of successful task executions to total attempts per agent domain.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "id": 11,
      "targets": [
        {
          "refId": "Finance",
          "expr": "sum(archonai_finance_analyses_total) / (sum(archonai_finance_analyses_total) + 1)",
          "legendFormat": "Finance",
          "instant": true
        },
        {
          "refId": "Sales",
          "expr": "sum(archonai_sales_pipeline_analyses_total) / (sum(archonai_sales_pipeline_analyses_total) + 1)",
          "legendFormat": "Sales",
          "instant": true
        },
        {
          "refId": "Ops",
          "expr": "sum(archonai_operations_analyses_total) / (sum(archonai_operations_analyses_total) + 1)",
          "legendFormat": "Ops",
          "instant": true
        },
        {
          "refId": "Marketing",
          "expr": "sum(archonai_marketing_campaign_analyses_total) / (sum(archonai_marketing_campaign_analyses_total) + 1)",
          "legendFormat": "Marketing",
          "instant": true
        },
        {
          "refId": "Support",
          "expr": "sum(archonai_support_ticket_analyses_total) / (sum(archonai_support_ticket_analyses_total) + 1)",
          "legendFormat": "Support",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "stacking": "none",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "type": "timeseries",
      "title": "Agent Execution P95 Latency",
      "description": "95th percentile task execution duration across all agents.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "id": 12,
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(archonai_task_execution_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "P95 Task Duration"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(archonai_operations_coordination_duration_ms_bucket[5m])) by (le))",
          "legendFormat": "P95 Coordination Duration"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Task Queue Depth",
      "description": "Current number of tasks queued minus tasks completed/failed.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "id": 13,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(archonai_tasks_queued_total) - sum(archonai_tasks_executed_total) - sum(archonai_tasks_failed_total)",
          "legendFormat": "Queue Depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      }
    },
    {
      "type": "gauge",
      "title": "Active Agents",
      "description": "Number of registered agents with active status.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "id": 14,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(archonai_agentregistry_registrations_total) - sum(archonai_agentregistry_status_changes_total)",
          "legendFormat": "Active Agents",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 20,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "type": "row",
      "title": "Connectors",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 20,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Connector Request Rate per System",
      "description": "Request rate (query + write ops) per connector system.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 17 },
      "id": 21,
      "targets": [
        {
          "refId": "Salesforce",
          "expr": "sum(rate(archonai_salesforce_query_ops_total[5m])) + sum(rate(archonai_salesforce_write_ops_total[5m]))",
          "legendFormat": "Salesforce"
        },
        {
          "refId": "HubSpot",
          "expr": "sum(rate(archonai_hubspot_query_ops_total[5m])) + sum(rate(archonai_hubspot_write_ops_total[5m]))",
          "legendFormat": "HubSpot"
        },
        {
          "refId": "Slack",
          "expr": "sum(rate(archonai_slack_query_ops_total[5m])) + sum(rate(archonai_slack_messages_sent_total[5m]))",
          "legendFormat": "Slack"
        },
        {
          "refId": "QuickBooks",
          "expr": "sum(rate(archonai_quickbooks_query_ops_total[5m])) + sum(rate(archonai_quickbooks_write_ops_total[5m]))",
          "legendFormat": "QuickBooks"
        },
        {
          "refId": "M365",
          "expr": "sum(rate(archonai_m365_query_ops_total[5m])) + sum(rate(archonai_m365_write_ops_total[5m]))",
          "legendFormat": "Microsoft 365"
        },
        {
          "refId": "GWS",
          "expr": "sum(rate(archonai_google_workspace_query_ops_total[5m])) + sum(rate(archonai_google_workspace_write_ops_total[5m]))",
          "legendFormat": "Google Workspace"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Connector Error Rate (%)",
      "description": "Error rate per connector system. Alert threshold at 5%.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 17 },
      "id": 22,
      "targets": [
        {
          "refId": "Salesforce",
          "expr": "sum(rate(archonai_salesforce_errors_total[5m])) / (sum(rate(archonai_salesforce_query_ops_total[5m])) + sum(rate(archonai_salesforce_write_ops_total[5m])) + 0.001) * 100",
          "legendFormat": "Salesforce"
        },
        {
          "refId": "HubSpot",
          "expr": "sum(rate(archonai_hubspot_errors_total[5m])) / (sum(rate(archonai_hubspot_query_ops_total[5m])) + sum(rate(archonai_hubspot_write_ops_total[5m])) + 0.001) * 100",
          "legendFormat": "HubSpot"
        },
        {
          "refId": "Slack",
          "expr": "sum(rate(archonai_slack_errors_total[5m])) / (sum(rate(archonai_slack_query_ops_total[5m])) + sum(rate(archonai_slack_messages_sent_total[5m])) + 0.001) * 100",
          "legendFormat": "Slack"
        },
        {
          "refId": "QuickBooks",
          "expr": "sum(rate(archonai_quickbooks_errors_total[5m])) / (sum(rate(archonai_quickbooks_query_ops_total[5m])) + sum(rate(archonai_quickbooks_write_ops_total[5m])) + 0.001) * 100",
          "legendFormat": "QuickBooks"
        },
        {
          "refId": "M365",
          "expr": "sum(rate(archonai_m365_errors_total[5m])) / (sum(rate(archonai_m365_query_ops_total[5m])) + sum(rate(archonai_m365_write_ops_total[5m])) + 0.001) * 100",
          "legendFormat": "Microsoft 365"
        },
        {
          "refId": "GWS",
          "expr": "sum(rate(archonai_google_workspace_errors_total[5m])) / (sum(rate(archonai_google_workspace_query_ops_total[5m])) + sum(rate(archonai_google_workspace_write_ops_total[5m])) + 0.001) * 100",
          "legendFormat": "Google Workspace"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": true,
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "table",
      "title": "Circuit Breaker State",
      "description": "Current circuit breaker state per connector: 0=CLOSED, 1=HALF-OPEN, 2=OPEN.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 17 },
      "id": 23,
      "targets": [
        {
          "refId": "A",
          "expr": "archonai_circuit_breaker_state",
          "legendFormat": "{{connector}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "center" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" } } },
                  { "type": "value", "options": { "1": { "text": "HALF-OPEN", "color": "yellow" } } },
                  { "type": "value", "options": { "2": { "text": "OPEN", "color": "red" } } }
                ]
              },
              { "id": "custom.displayMode", "value": "color-background-solid" }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "connector", "desc": false }],
        "footer": { "show": false }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
            "renameByName": { "connector": "Connector", "Value": "State" }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Governance",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 25 },
      "id": 30,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Pending Approvals",
      "description": "Number of governance approval gates in pending state. Alerts if > 10.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 26 },
      "id": 31,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(archonai_admin_workflow_queries_total) - sum(archonai_admin_policy_updates_total)",
          "legendFormat": "Pending",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Override Rate (%)",
      "description": "Percentage of policy evaluations that resulted in a manual override.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 26 },
      "id": 32,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(archonai_rbac_access_denials_total[5m])) / (sum(rate(archonai_rbac_access_checks_total[5m])) + 0.001) * 100",
          "legendFormat": "Override %",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
    {
      "type": "gauge",
      "title": "Policy Evaluations/sec",
      "description": "Rate of RBAC access checks per second.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 26 },
      "id": 33,
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(archonai_rbac_access_checks_total[5m]))",
          "legendFormat": "evals/s",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    }
  ]
}
