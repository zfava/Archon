# ══════════════════════════════════════════════════════════════════
#  ArchonAI — Environment Configuration
# ══════════════════════════════════════════════════════════════════
#
#  Copy this file to .env and fill in ALL required values:
#    cp .env.example .env
#
#  Generate secure values:
#    ARCHONAI_JWT_SIGNING_KEY: openssl rand -base64 48
#    POSTGRES_PASSWORD:        openssl rand -base64 24
#
#  IMPORTANT: NEVER commit the .env file to source control.
# ══════════════════════════════════════════════════════════════════

# ─── Security (REQUIRED) ──────────────────────────────────────────
# JWT signing key — minimum 32 characters. Generate with:
#   openssl rand -base64 48
ARCHONAI_JWT_SIGNING_KEY=

# ─── Database (REQUIRED) ──────────────────────────────────────────
POSTGRES_DB=archonai
POSTGRES_USER=archonai
# Database password — generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# PostgreSQL SSL mode — enforced by PostgresConnectionStringBuilder.Harden()
# Default is Require (TLS required, server certificate verified).
POSTGRES_SSL_MODE=Require
# Set ARCHONAI_POSTGRES_SSL_DISABLE=true ONLY for local development without TLS certificates.
# This disables SSL entirely and must NEVER be used in production.
# ARCHONAI_POSTGRES_SSL_DISABLE=true

# ─── Model Providers (REQUIRED — at least one cloud provider) ────
# At least one of OPENAI_API_KEY or ANTHROPIC_API_KEY must be set
# for AI-powered features to function. Without a cloud provider key,
# all AI requests will fail — there is no echo/stub fallback.
#
# Default routing uses OpenAI. If only Anthropic is configured,
# update ModelProviders:DefaultModel in appsettings.json.

# OpenAI (https://platform.openai.com/api-keys) — DEFAULT PROVIDER
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Azure OpenAI (requires Azure subscription with OpenAI resource)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Local model server (Ollama or compatible) — optional, last-resort fallback only
ARCHONAI_LOCAL_ENDPOINT=http://localhost:11434

# ─── Event Bus ────────────────────────────────────────────────────
# NATS is used by default in docker-compose; no extra config needed.
