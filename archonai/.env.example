# ArchonAI Environment Configuration
# Copy this file to .env and fill in the values for your deployment.

# ─── Security ───────────────────────────────────────────────
ARCHONAI_JWT_SIGNING_KEY=change-me-please-use-at-least-32-characters

# ─── Model Providers ────────────────────────────────────────
# Enable/disable individual providers (true/false)
ARCHONAI_OPENAI_ENABLED=true
ARCHONAI_ANTHROPIC_ENABLED=true
ARCHONAI_AZURE_OPENAI_ENABLED=false
ARCHONAI_LOCAL_ENABLED=true

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Azure OpenAI (requires Azure subscription with OpenAI resource)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Local model server (Ollama or compatible)
ARCHONAI_LOCAL_ENDPOINT=http://localhost:11434

# ─── Database ───────────────────────────────────────────────
POSTGRES_DB=archonai
POSTGRES_USER=archonai
POSTGRES_PASSWORD=archonai

# ─── Event Bus ──────────────────────────────────────────────
# NATS is used by default in docker-compose; no extra config needed.
